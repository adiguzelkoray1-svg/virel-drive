// Virel Drive — çok kiracılı veri modeli (sürücü kursları)
// PostgreSQL. Durum alanları String + sabitler (src/lib/constants.ts).
// Mevzuata bağlı sayılar koda gömülmez: LicenseClassRule + RegulationSetting + DocumentTypeRule.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Kiracı (sürücü kursu) ----------
model School {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  city         String?
  district     String?
  phone        String?
  email        String?
  address      String?
  taxNumber    String?
  taxOffice    String?
  mebCode      String?   // kurum kodu
  timezone     String    @default("Europe/Istanbul")
  currency     String    @default("TRY")
  status       String    @default("PENDING") // PENDING | TRIAL | ACTIVE | PAST_DUE | SUSPENDED | DELETED
  plan         String    @default("TRIAL")   // TRIAL | STARTER | PRO | ENTERPRISE
  trialEndsAt  DateTime?
  userLimit    Int       @default(3)
  studentLimit Int       @default(150)
  approvedAt   DateTime?
  kvkkAcceptedAt DateTime?
  settings     String?   // JSON: çalışma saatleri, derslikler, fatura öneki

  // Her kurs SMS'i kendi NetGSM hesabından gönderir — paylaşılan bir platform hesabı yok.
  // Şifre düz metin: NetGSM API'sine her gönderimde yeniden kullanılması gerekiyor, tek yönlü
  // hash'lenemez (kullanıcı şifreleri gibi değil). Yalnızca settings.write yetkisi olanlar görür/değiştirir.
  netgsmUsername String?
  netgsmPassword String?
  netgsmHeader   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  users        User[]
  students     Student[]
  leads        Lead[]
  instructors  Instructor[]
  vehicles     Vehicle[]
  vehicleCosts VehicleCost[]
  theoryLessons TheoryLesson[]
  attendances  Attendance[]
  drivingLessons DrivingLesson[]
  skillRatings SkillRating[]
  exams        Exam[]
  drivingCandidateCertificates DrivingCandidateCertificate[]
  documents    Document[]
  paymentPlans PaymentPlan[]
  installments Installment[]
  payments     Payment[]
  expenses     Expense[]
  messages     MessageLog[]
  classRules   LicenseClassRule[]
  documentTypeRules DocumentTypeRule[]
  messageTemplateRules MessageTemplateRule[]
  regulations  RegulationSetting[]
  auditLogs    AuditLog[]
  paymentLinks PaymentLink[]

  @@index([status])
}

// ---------- Kullanıcı ----------
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  phone        String?
  role         String    @default("SECRETARY") // SUPER_ADMIN | OWNER | MANAGER | SECRETARY | THEORY_TEACHER | DRIVING_INSTRUCTOR | ACCOUNTANT | STUDENT
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  schoolId     String?
  school       School?   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  instructor   Instructor?
  student      Student?
  auditLogs    AuditLog[]
  paymentLinks PaymentLink[]

  @@index([schoolId, role])
}

// ---------- Kursiyer ----------
model Student {
  id             String    @id @default(cuid())
  schoolId       String
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId         String?   @unique
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  fileNo         String?   // dosya numarası
  firstName      String
  lastName       String
  phone          String
  email          String?
  nationalId     String?   // TC — KVKK: telefon gibi ekranlarda maskelenir (maskNationalId)
  birthDate      DateTime?
  address        String?
  photoUrl       String?

  licenseClass   String    // B | A2 | A | C | D ... (LicenseClassRule.code)
  stage          String    @default("PRE_REGISTRATION") // PRE_REGISTRATION | DOCUMENTS | THEORY | ETEST_WAITING | DRIVING | DRIVING_EXAM | GRADUATED
  status         String    @default("ACTIVE")           // ACTIVE | PASSIVE | GRADUATED | CANCELLED
  registeredAt   DateTime  @default(now())
  graduatedAt    DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  documents      Document[]
  attendances    Attendance[]
  drivingLessons DrivingLesson[]
  exams          Exam[]
  drivingCandidateCertificates DrivingCandidateCertificate[]
  paymentPlan    PaymentPlan?
  payments       Payment[]
  messages       MessageLog[]
  lead           Lead?

  @@index([schoolId, status])
  @@index([schoolId, stage])
  @@index([schoolId, phone])
}

// ---------- CRM / ön kayıt ----------
model Lead {
  id            String    @id @default(cuid())
  schoolId      String
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name          String
  phone         String
  email         String?
  licenseClass  String?
  source        String    @default("OTHER") // INSTAGRAM | WEB | REFERRAL | PHONE | WALK_IN | OTHER
  stage         String    @default("NEW")   // NEW | INFORMED | QUOTED | FOLLOW_UP | MEETING | WON | LOST
  lostReason    String?
  nextFollowUpAt DateTime?
  lastContactAt DateTime?
  // Kayda dönüşme anı ayrı tutulur: updatedAt her düzenlemede değiştiği için
  // dönüşüm oranı ve ortalama kapanış süresi ondan hesaplanamaz.
  wonAt         DateTime?
  studentId     String?   @unique
  student       Student?  @relation(fields: [studentId], references: [id], onDelete: SetNull)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([schoolId, stage])
  @@index([schoolId, nextFollowUpAt])
}

// ---------- Evrak ----------
model Document {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type        String    // NATIONAL_ID | DIPLOMA | HEALTH_REPORT | CRIMINAL_RECORD | PHOTO | DRIVER_CONSENT | BLOOD_TYPE
  status      String    @default("PENDING") // PENDING | REVIEW | OK | MISSING
  fileUrl     String?
  validUntil  DateTime?
  verifiedAt  DateTime?
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([studentId, type])
  @@index([schoolId, status])
}

// ---------- Eğitmen ----------
model Instructor {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId         String?  @unique
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  name           String
  phone          String?
  mebLicenseNo   String?                      // MEB izin belgesi numarası — Özel MTSK Modülü'nde personel kaydının zorunlu alanı
  branch         String   @default("DRIVING") // DRIVING | THEORY
  licenseClasses String   @default("B")       // virgülle: "B,A2"
  subjects       String?                      // teorik: "TRAFFIC,FIRST_AID"
  weeklyCapacity Int      @default(40)        // saat
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  drivingLessons DrivingLesson[]
  theoryLessons  TheoryLesson[]
  vehicles       Vehicle[]
  expenses       Expense[]

  @@index([schoolId, branch])
}

// ---------- Araç ----------
model Vehicle {
  id            String    @id @default(cuid())
  schoolId      String
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plate         String
  brand         String?
  model         String?
  year          Int?
  licenseClass  String    @default("B")
  usage         String    @default("TRAINING") // TRAINING | EXAM
  status        String    @default("ACTIVE")   // ACTIVE | MAINTENANCE | PASSIVE
  km            Int       @default(0)
  fuelType      String?
  insuranceUntil DateTime?
  inspectionUntil DateTime?
  nextServiceKm Int?
  instructorId  String?
  instructor    Instructor? @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  drivingLessons DrivingLesson[]
  costs          VehicleCost[]

  @@unique([schoolId, plate])
  @@index([schoolId, status])
}

model VehicleCost {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type       String   // FUEL | SERVICE | TIRE | INSURANCE | INSPECTION | REPAIR | OTHER
  amount     Int      // kuruş
  km         Int?
  note       String?
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([schoolId, occurredAt])
  @@index([vehicleId, type])
}

// ---------- Teorik eğitim ----------
model TheoryLesson {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  category     String   // TRAFFIC | FIRST_AID | ENGINE | ETHICS
  topic        String
  term         String?  // "2026/3"
  room         String?
  instructorId String?
  instructor   Instructor? @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  startsAt     DateTime
  endsAt       DateTime
  status       String   @default("PLANNED") // PLANNED | LIVE | DONE | CANCELLED
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  attendances  Attendance[]

  @@index([schoolId, startsAt])
}

model Attendance {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  theoryLessonId String
  theoryLesson   TheoryLesson @relation(fields: [theoryLessonId], references: [id], onDelete: Cascade)
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  present        Boolean  @default(true)
  excused        Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@unique([theoryLessonId, studentId])
  @@index([schoolId, studentId])
}

// ---------- Direksiyon eğitimi ----------
model DrivingLesson {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Restrict)
  vehicleId    String
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  startsAt     DateTime
  endsAt       DateTime
  kind         String   @default("CITY") // CITY | PARKING | HILL | HIGHWAY | EXAM_PREP
  status       String   @default("PLANNED") // PLANNED | LIVE | DONE | CANCELLED | NO_SHOW
  note         String?
  reviewNote   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ratings      SkillRating[]

  @@index([schoolId, startsAt])
  @@index([instructorId, startsAt])
  @@index([vehicleId, startsAt])
  @@index([studentId, startsAt])
}

model SkillRating {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    DrivingLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  skill     String   // START_STOP | CLUTCH | GEARS | MIRRORS | LANE | JUNCTION | PARKING | REVERSE | HILL_START | TRAFFIC | SAFETY
  score     Int      // 1..5
  createdAt DateTime @default(now())

  @@unique([lessonId, skill])
}

/// K Sınıfı Sürücü Aday Belgesi (Ek-5) — MTSK Yönetmeliği md.19: "G" sınıfı hariç tüm
/// kursiyerlerin akan trafikte direksiyon eğitimi alabilmesi/sınava girebilmesi için kurs
/// müdürlüğünce düzenlenen resmi belge. 6 ay geçerli; ilk 4 direksiyon sınavı hakkı
/// tükendiğinde ya da süre dolduğunda YENİDEN düzenlenir — bu yüzden tek satır güncellenmez,
/// her düzenleme yeni bir satır açar (defter tutulur, geçmiş dönemler kaybolmaz). Sınav
/// komisyonu, sınavda bu belgenin süresinin dolup dolmadığını fiilen kontrol ediyor — süresi
/// geçmiş kursiyer sınava alınmıyor, bu yüzden okulun bunu takip etmesi gerçek bir risktir.
model DrivingCandidateCertificate {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  startedAt DateTime // akan trafikte direksiyon eğitimine başlama tarihi
  expiresAt DateTime // startedAt + 6 ay
  createdAt DateTime @default(now())

  @@index([schoolId, studentId])
  @@index([schoolId, expiresAt])
}

// ---------- Sınavlar ----------
model Exam {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type        String    // ETEST | DRIVING
  attemptNo   Int       @default(1)
  scheduledAt DateTime?
  place       String?
  status      String    @default("PLANNED") // PLANNED | APPLIED | DONE | CANCELLED
  result      String?   // PASSED | FAILED
  score       Int?
  failReason  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([schoolId, type, scheduledAt])
  @@index([studentId, type])
}

// ---------- Finans ----------
model PaymentPlan {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId   String   @unique
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  total       Int      // kuruş
  downPayment Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  installments Installment[]
}

model Installment {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  planId    String
  plan      PaymentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  seq       Int
  label     String?  // "Peşinat", "1. taksit"
  amount    Int
  dueAt     DateTime
  paidAt    DateTime?
  status    String   @default("PENDING") // PENDING | PAID | OVERDUE | CANCELLED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments  Payment[]

  @@index([schoolId, status, dueAt])
}

model Payment {
  id            String   @id @default(cuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  installmentId String?
  installment   Installment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  amount        Int
  method        String   @default("CASH") // CASH | CARD | TRANSFER | ONLINE
  receivedAt    DateTime @default(now())
  note          String?
  createdAt     DateTime @default(now())

  @@index([schoolId, receivedAt])
}

model Expense {
  id           String      @id @default(cuid())
  schoolId     String
  school       School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  category     String      // RENT | SALARY | VEHICLE | UTILITY | MARKETING | OTHER
  /// category=SALARY iken belirli bir eğitmene bağlanabilir — eğitmen detayındaki "Maaş ve
  /// avans" hesap ekstresi bu alanla filtrelenir. Boş bırakılırsa genel/dağıtılmamış personel
  /// gideri sayılır (önceki davranış korunur). Yönetici rolleri (OWNER/MANAGER/SECRETARY/
  /// ACCOUNTANT) için ayrı bir profil kaydı yok, bu yüzden şimdilik yalnızca Instructor'a
  /// bağlanabiliyor — en büyük ve en operasyonel personel grubu bu.
  instructorId String?
  instructor   Instructor? @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  /// Yalnızca category=SALARY iken anlamlı: MAAS | AVANS.
  subcategory  String?
  amount       Int
  note         String?
  occurredAt   DateTime    @default(now())
  createdAt    DateTime    @default(now())

  @@index([schoolId, occurredAt])
  @@index([schoolId, instructorId])
}

// ---------- Mesaj ----------
model MessageLog {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  channel   String   // WHATSAPP | SMS | EMAIL | PUSH
  template  String?
  body      String
  direction String   @default("OUT") // OUT | IN
  status    String   @default("QUEUED") // QUEUED | SENT | DELIVERED | READ | FAILED
  sentAt    DateTime?
  createdAt DateTime @default(now())

  @@index([schoolId, createdAt])
}

// ---------- Mevzuat ve kurs ayarları ----------
model LicenseClassRule {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  code           String   // B | A2 | C | D | A
  vehicleKind    String   // Otomobil | Motosiklet | Kamyon | Otobüs
  drivingHours   Int      // zorunlu direksiyon saati
  theoryLessons  Int      // zorunlu teorik ders sayısı
  examAttempts   Int      @default(4)
  passScore      Int      @default(70)
  /// Üçü de boş bırakılabilir (null) — o zaman Finans'taki ödeme planı formu, o sınıftaki
  /// mevcut planların en sık görülen tutarını önerir (bkz. finans/kursiyer/[id]/page.tsx).
  /// Doldurulunca o veri temelli tahminin yerini alır: yeni açılan bir kursta ya da bir
  /// sınıfın ilk kursiyerinde veri temelli öneri hiç çalışmaz (soğuk başlangıç sorunu),
  /// ayrıca fiyat artışında "en sık görülen" eski fiyatta uzun süre takılı kalabilir.
  defaultPrice            Int? // kuruş
  defaultDownPayment      Int? // kuruş
  defaultInstallmentCount Int?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([schoolId, code])
}

/// Kursiyer kaydında toplanması zorunlu belge türleri. Mevzuata bağlı sayılar gibi koda
/// gömülmez (bkz. dosya başındaki not) — okul yeni bir yerel belge eklemek isteyebilir.
/// Silinmez, yalnızca pasifleştirilir: mevcut kursiyerlerin o türdeki `Document` satırı
/// (schema'da @@unique([studentId, type]) ile korunan, serbest metin `type` referansı)
/// kuralın kendisi silinse bile anlamlı kalmaya devam etmeli — LicenseClassRule ile aynı gerekçe.
model DocumentTypeRule {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  key            String   // NATIONAL_ID | DIPLOMA | ... ya da özel eklenen tür için etiketten türetilmiş anahtar
  label          String
  validityMonths Int?     // örn. sağlık raporu 24 ay geçerli; boşsa süresiz
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([schoolId, key])
  @@index([schoolId, isActive])
}

/// Mesajlar modülünde konuşma ekranında tek tıkla kullanılan hazır şablonlar — DocumentTypeRule
/// ile aynı gerekçeyle koda gömülü değil: kurs kendi diline uygun bir şablon eklemek/düzenlemek
/// isteyebilir. `body` içinde `{ad}` kursiyer adıyla, `{kurs}` kursun kendi adıyla değiştirilir
/// (bkz. Composer.tsx) — ikincisi olmadan "Hoş geldiniz" gibi şablonlar başka bir kursun adını
/// taşıyabilirdi (gerçek bir hata: WELCOME şablonu eskiden "Yıldız Sürücü Kursu" diye sabitti).
model MessageTemplateRule {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  key       String   // LESSON_REMINDER | ... ya da özel eklenen şablon için etiketten türetilmiş anahtar
  label     String
  body      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, key])
  @@index([schoolId, isActive])
}

/// Serbest anahtar/değer: ders süresi, günlük azami ders, devam oranı, iptal süresi vb.
model RegulationSetting {
  id        String   @id @default(cuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  key       String
  value     String
  updatedAt DateTime @updatedAt

  @@unique([schoolId, key])
}

// ---------- Platform (Virel) faturalama ----------
/// Kurs açma tamamen süper admin elinden gittiği gibi, ücretli plana geçiş de öyle: satış
/// görüşmesi sonrası süper admin bir ödeme linki oluşturur, kurs sahibine kendisi iletir
/// (e-posta/WhatsApp) — bu yüzden link genel (public) bir URL'dir, giriş gerektirmez; kurs
/// sahibinin henüz oturumu olmayabilir. Bkz. app/odeme/lisans/[id], lib/providers/paytr.ts.
model PaymentLink {
  id          String    @id @default(cuid())
  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  plan        String    // STARTER | PRO | ENTERPRISE
  amountKurus Int
  description String?
  status      String    @default("PENDING") // PENDING | PAID | CANCELLED
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([schoolId])
}

// ---------- Denetim ----------
model AuditLog {
  id        String   @id @default(cuid())
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  target    String?
  meta      String?
  createdAt DateTime @default(now())

  @@index([schoolId, createdAt])
}

// ---------- Tanıtım sitesi ----------
model DemoRequest {
  id         String    @id @default(cuid())
  schoolName String
  name       String
  email      String
  phone      String?
  city       String?
  size       String?   // kurs büyüklüğü: SOLO | SMALL | MEDIUM | LARGE
  message    String?
  source     String    @default("WEB")
  status     String    @default("NEW") // NEW | CONTACTED | CONVERTED | CLOSED
  note       String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status, createdAt])
}
