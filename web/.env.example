# PostgreSQL bağlantısı
DATABASE_URL="postgresql://kullanici@localhost:5432/virel_drive"

# Oturum JWT imzası — `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
AUTH_SECRET=""

# Seed'de oluşturulacak süper admin hesabı — boş bırakılırsa seed.ts'deki varsayılana düşer.
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""

APP_URL="http://localhost:3002"

# Tanıtım sayfasındaki (/) demo formu için — hiçbiri tanımlı değilse e-posta
# yerine sunucu günlüğüne yazılır, form yine de çalışır.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""
# Yeni demo talebi bildirimi kime gitsin — boşsa SUPER_ADMIN_EMAIL kullanılır.
DEMO_NOTIFY_EMAIL=""

# Mesajlar modülünde SMS kanalı için NetGSM (https://www.netgsm.com.tr) — üçü de tanımlı
# değilse gerçek gönderim yapılmaz, sunucu günlüğüne yazılır (form yine çalışır).
NETGSM_USERNAME=""
NETGSM_PASSWORD=""
NETGSM_HEADER=""
